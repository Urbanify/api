# HTTP server port (default 3000)
SERVER_PORT=
# JWT signing secret used to issue/verify tokens
JWT_SECRET=
# Prisma primary database connection string
DATABASE_URL=
# Prisma direct/maintenance connection (optional, often points to same DB)
DIRECT_URL=
# Internal API key used to secure private endpoints
API_KEY=
# Resend API key for outgoing email (optional locally: emails are skipped with a warning if unset)
RESEND_API_KEY=
# Sender address for emails (defaults to Urbanify <noreply@urbanify.com.br>)
MAIL_SERVICE_FROM=
# Frontend base URL for CORS/redirects
FRONTEND_URL=
# Apps Script web app URL that appends leads to the internal sheet (optional: rows are skipped if unset)
SHEETS_WEBHOOK_URL=
# Expo access token for push notifications (optional: sends go out without it)
EXPO_ACCESS_TOKEN=
